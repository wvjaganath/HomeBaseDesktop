{
  "name": "homebase-hub-server",
  "version": "2.0.0",
  "private": true,
  "description": "HomeBase hub server: sync API for the iOS app plus the HomeBase Desktop web app, plane tracker adapter, radar and calendar.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "logos": "node --env-file-if-exists=.env dist/scripts/fetchLogos.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "node-ical": "0.27.3",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
