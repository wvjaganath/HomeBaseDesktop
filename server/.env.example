# Copy this file to .env and fill in values. Never commit .env.

# Where the server listens. 0.0.0.0 exposes it on your LAN (required for the phones).
HOST=0.0.0.0
PORT=3000

# SQLite database file path (created on first run).
DB_PATH=./homebase.db

# REQUIRED. Long random string (at least 32 chars) used to sign access tokens.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Set to false after you and your wife have both registered.
ALLOW_REGISTRATION=true

# Token lifetimes.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
