# For running the hub without Docker (development). Copy to .env, chmod 600.
# Most settings are in the browser (Settings → Hub, Settings → Plane tracker)
# and stored in the database; this file only has what the hub needs to start.

HOST=0.0.0.0
PORT=3000
# Where the SQLite DB and other persistent data live.
DATA_DIR=./data
# DB_PATH=./data/homebase.db
# Time zone for dates and the nightly backup (Docker sets TZ for you).
TZ=America/Chicago

# REQUIRED. At least 32 random bytes:  openssl rand -hex 32
JWT_SECRET=
# Optional separate key for encrypting stored secrets. Set it once or never.
# SECRETS_KEY=

# Plain cookies over http:// in development (Docker uses "auto").
COOKIE_SECURE=false
TRUST_PROXY=false

# The plane tracker's web UI (Docker points this at the bundled tracker).
TRACKER_URL=http://planetracker.local:8080
