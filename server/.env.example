# Copy to .env and fill in. Never commit .env (chmod 600 it).

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Where the SQLite DB and other persistent data live.
DATA_DIR=./data
# Optional override of the DB file (defaults to $DATA_DIR/homebase.db).
# DB_PATH=./data/homebase.db
LOG_LEVEL=info

# REQUIRED. At least 32 random bytes:  openssl rand -hex 32
JWT_SECRET=
# Optional separate key for encrypting stored secrets (calendar URLs).
# If empty, one is derived from JWT_SECRET.  openssl rand -hex 32
SECRETS_KEY=

# Set to false after both accounts are registered.
ALLOW_REGISTRATION=true
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to true once the hub is served over HTTPS (Phase 7). Enables Secure
# cookies, the __Host- cookie prefix and HSTS.
COOKIE_SECURE=false
# Set to true only when running behind a trusted reverse proxy (Caddy).
TRUST_PROXY=false

# --- Home location (for the radar and distances) ------------------------------
HOME_LAT=41.7000
HOME_LON=-87.9000
# imperial | metric
UNITS=imperial
TIMEZONE=America/Chicago

# --- Plane tracker (the LED Pi) ----------------------------------------------
# Base URL of the tracker's web UI. Leave empty to disable the integration.
TRACKER_URL=http://planetracker.local:8080

# --- Radar (ADS-B) ------------------------------------------------------------
RADAR_ENABLED=true
RADAR_RADIUS_NM=30
# Contact shown in the User-Agent sent to adsb.lol / adsb.fi / adsbdb
# (their terms ask for a way to reach you).
ADSB_CONTACT=you@example.com
