# HTTPS front door for HomeBase on the home network (README §6.6).
#
# Caddy runs its own small certificate authority ("tls internal"): no domain,
# no internet exposure, no Let's Encrypt. Trust its root certificate once on
# each computer/Pi (deploy/README.md §3) and browsers show a normal padlock.
#
#   https://<HUB_HOSTS>:8443  →  hub   (all browsers, the Pi included)
#   http://…:8080        →  308 to https (old bookmarks / screen links)
#   http://…:3000        →  hub directly, published by the hub service (iPhones)
{
	# No admin API: config changes = edit this file + `docker compose restart caddy`.
	admin off
	# The container can't (and shouldn't) touch a system trust store.
	skip_install_trust
	# Unprivileged ports inside the container (published as HTTPS_PORT, default 8443).
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	pki {
		ca local {
			name "HomeBase Local CA"
		}
	}
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format console
		level WARN
	}
}

{$HUB_HOSTS} {
	tls internal

	encode zstd gzip

	reverse_proxy {$HUB_UPSTREAM:hub:3000} {
		# The hub trusts X-Forwarded-* only from Caddy's fixed address
		# (TRUST_PROXY in docker-compose.yml). Caddy sets them itself and
		# replaces anything a client sent.
		header_up -X-Real-IP
		# Server-sent events (live updates) and the Mirror websocket.
		flush_interval -1
	}

	# The hub sets its own security headers; just hide the server banner.
	header -Server
}

http://:8080 {
	redir https://{host}:{$HTTPS_PORT:8443}{uri} 308
}

# Read-only feed for the LED board, which runs the tracker as a slave of this
# PC (Master Tracker Hostname = <pc-ip>:8081 on the board). Only the paths a
# slave reads, only GET, only from private (LAN) addresses. The tracker's
# settings, restart and Wi-Fi endpoints are never reachable here.
http://:8081 {
	@feed {
		method GET HEAD
		remote_ip private_ranges
		path /overhead/json /tracked/json/live /weather/json /clock/json /iss/json /airport-status/json
	}
	handle @feed {
		reverse_proxy {$TRACKER_UPSTREAM:tracker:8080}
	}
	handle {
		respond "Not found" 404
	}
}
