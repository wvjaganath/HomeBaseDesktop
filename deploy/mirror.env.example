# Copy to mirror.env and chmod 600. Never commit mirror.env.
# Settings for the MagicMirror² container (Mirror tab).

# A screen link's token (read-only). In the hub: Settings → Screens → name it
# "MagicMirror" → Create link, then copy the part after "t=" (starts hbd_).
HOMEBASE_DEVICE_TOKEN=

# Weather location (same as hub.env)
HOME_LAT=
HOME_LON=
UNITS=imperial
