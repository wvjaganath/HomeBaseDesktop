# Copy to hub.env and chmod 600. Never commit hub.env.
# (Same settings as server/.env.example; DATA_DIR is set by docker-compose.)

LOG_LEVEL=info

# REQUIRED: openssl rand -hex 32
# If you are moving an existing HomeBase server, reuse its JWT_SECRET so the
# phones stay logged in.
JWT_SECRET=
# Optional: openssl rand -hex 32  (encrypts stored calendar URLs)
SECRETS_KEY=

# false: only the very first account can be created from the sign-in screen;
# after that, add people in Settings → People. true: anyone can sign up.
ALLOW_REGISTRATION=false
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# auto = Secure cookies on https:// (via Caddy), plain cookies on the LAN-only
# http://…:3000 port. TRUST_PROXY and MIRROR_URL are set in docker-compose.yml.
COOKIE_SECURE=auto

# Nightly database backups into deploy/backups (0 turns them off)
BACKUP_KEEP=14
BACKUP_HOUR=3

# Home for the radar and maps. Leave empty to use the home location saved in
# Settings -> Plane tracker (the bundled tracker).
HOME_LAT=
HOME_LON=
UNITS=imperial
TIMEZONE=America/Chicago

# The plane tracker now runs on this PC (the "tracker" service in
# docker-compose.yml), so TRACKER_URL is set there. Only set it here if you run
# the hub without Docker and the tracker somewhere else.
# TRACKER_URL=http://tracker:8080

# The LED board Pi's own tracker web UI, so its settings (brightness, panel,
# Wi-Fi, which server it follows) can be edited in HomeBase too:
# Settings -> Plane tracker -> LED board. Leave unset to skip.
# LED_BOARD_URL=http://192.168.1.60:8080

RADAR_ENABLED=true
# Free key for the dark map background (Radar, Closest & farthest maps):
# https://carto.com/basemaps/apikey/  (no account needed; non-commercial use
# is free up to 5 million tiles a month). Without it the map says
# "API KEY REQUIRED". The hub fetches the tiles, so the key stays on the PC.
CARTO_API_KEY=
RADAR_RADIUS_NM=30
ADSB_CONTACT=you@example.com
