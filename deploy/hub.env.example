# Copy to hub.env and chmod 600. Never commit hub.env.
#
# This file only holds the hub's secret keys. Everything else is set in the
# browser: Settings → Hub (sign-in, radar & map key, LED board, backups…) and
# Settings → Plane tracker (home location, units, API keys…). Docker-level
# settings (ports, host names, time zone, image versions) are in deploy/.env.

# REQUIRED: openssl rand -hex 32
# Signs every sign-in. Moving an existing HomeBase server? Reuse its JWT_SECRET
# so the phones stay signed in. Changing it signs everyone out.
JWT_SECRET=

# Optional: openssl rand -hex 32
# Encrypts saved secrets (Google calendar addresses, the map key). Without it
# they're encrypted with a key derived from JWT_SECRET. Set it once, at the
# start, or not at all: changing it makes those saved secrets unreadable.
# SECRETS_KEY=
