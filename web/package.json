    "eslint": "10.13.0",
    "eslint-plugin-svelte": "PIN_AT_INSTALL",
    "globals": "PIN_AT_INSTALL",
    "svelte": "5.57.2",
    "svelte-check": "PIN_AT_INSTALL",
    "typescript": "7.0.2",
